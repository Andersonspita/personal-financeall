DATABASE_URL="file:./prisma/dev.db"

# Gere uma chave forte em produção, por exemplo:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMOTION_ENCRYPTION_KEY="replace-with-a-strong-random-secret"
AUTH_SECRET="replace-with-a-different-strong-random-secret"

# Cookie Secure: em HTTPS deixe true (ou omita em produção). Em http://IP:porta use false.
# AUTH_COOKIE_SECURE="false"

# URL pública do app (links de e-mail e callback do Google). Na VPS: http://184.107.179.70:3000
# APP_BASE_URL="http://localhost:3000"

# Login com Google (Cloud Console → OAuth client). Redirect: {APP_BASE_URL}/api/auth/google/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# E-mail de recuperação de senha. Sem isso, o link só aparece no log do servidor.
# MAIL_FROM="Bússola Financeira <noreply@seudominio.com>"
# SMTP_HOST="smtp.seudominio.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_SECURE="false"
# ou:
# RESEND_API_KEY="re_..."

# Opcional: sem isso, o assistente de IA fica desativado (o resto do app funciona normalmente).
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"
